# ==============================================================================
# yajubot 環境変数設定ファイル
# このファイルをコピーして「.env」を作成し、値を設定してください。
# ※ .env ファイルには秘密情報が含まれるため、Git には絶対にコミットしないでください。
# ==============================================================================

# 【必須】Discord Developer Portal で取得した Bot トークン
DISCORD_TOKEN=your_discord_bot_token_here

# 【任意】開発・テスト用サーバー（Guild）の ID
# 設定すると、起動時にそのサーバーへ即座にスラッシュコマンドを同期します（推奨）。
# 空欄にすると、全サーバー向けのグローバル同期を行います（反映まで最大1時間かかる場合があります）。
DISCORD_GUILD_ID=

# 【任意】ログ出力レベル（DEBUG / INFO / WARNING / ERROR / CRITICAL）
LOG_LEVEL=INFO
